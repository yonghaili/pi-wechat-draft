# 微信后台服务的本机偏好（KEY=VALUE，每行一个）。改完执行 wx svc stop && wx svc start 生效。
# 这个文件不进 git，只影响本机；安装脚本会把它从 wx-service.env.example 复制一份出来。

# ① 写字的动作（draft/send）要求的空闲秒数：只有你停止鼠标键盘操作这么久，服务才动手。
#    默认值 2 秒太激进——手停两秒就被抢焦点，这就是"总被打断"的来源。想恢复即时执行改成 2。
WX_IDLE_GATE=20

# ② 只读动作（check/clear）要求的空闲秒数。它们不改内容、只看一眼；
#    想让"连检查也不打扰"就也提到 20。
WX_IDLE_GATE_RO=0.5

# ③ 降级兜底：一直用电脑时可能永远等不到 20s 长空闲。任务已等超过 WX_IDLE_FALLBACK 秒
#    时，只要有 WX_IDLE_FALLBACK_MIN 秒安静就执行，避免任务被永久饿死在队列里。
#    设 0 = 禁用降级（宁可一直等，也绝不打断你）。
WX_IDLE_FALLBACK=600
WX_IDLE_FALLBACK_MIN=5

# ④ 单个任务最多盯多久空闲就放回队列（秒）。取小值是为了让 --now 的插队能及时生效。
WX_IDLE_MAX_WAIT=60

# ⑤ 任务收尾是否把上游库为让开点击路径而最小化的"遮挡窗口"还原（保留其最大化状态）。
#    建议保持 1：库最小化你的窗口后自己从不还原。
WX_RESTORE_BLOCKERS=1
